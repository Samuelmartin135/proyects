# Copie este archivo como .env y complete los valores.
# Las variables EXPO_PUBLIC_* quedan dentro de la app: NUNCA ponga aquí claves secretas.

# Supabase → Project Settings → API (se usará desde el paso 4)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=su-clave-publicable

# Proveedor de pagos: "mock" (simulado, para demos) o "sumup" (cuando tengamos el SDK)
EXPO_PUBLIC_PAYMENT_PROVIDER=mock
